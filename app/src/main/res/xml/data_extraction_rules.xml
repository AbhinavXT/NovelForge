<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Holds an Anna's Archive account key. -->
        <exclude domain="sharedpref" path="annas_archive.xml"/>
        <exclude domain="sharedpref" path="opds_credentials.xml"/>
        <!-- Offline dictionaries can exceed the 25 MB backup quota on their own. -->
        <exclude domain="file" path="dictionaries/"/>
        <!-- Same for an imported font: CJK fonts run to tens of MB. -->
        <exclude domain="file" path="fonts/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="annas_archive.xml"/>
        <exclude domain="sharedpref" path="opds_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>